{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore": "Warning",
      "BareWire": "Information"
    }
  },
  "AllowedHosts": "*",
  "Transport": "InMemory",
  "ConnectionStrings": {
    "rabbitmq": "amqp://guest:guest@localhost:5672/"
  },
  "Smoke": {
    "Enabled": false,
    "OrderCount": 5,
    "TimeoutSeconds": 30
  }
}
